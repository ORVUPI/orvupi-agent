{
  "name": "@orvupi/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Public skeleton of the ORVUPI agent. No wallet, no signing, no custody, no network writes.",
  "license": "MIT",
  "author": "ORVUPI <orvupi.hq@gmail.com>",
  "homepage": "https://stubxai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ORVUPI/orvupi-agent.git"
  },
  "bugs": {
    "email": "orvupi.hq@gmail.com"
  },
  "type": "module",
  "bin": {
    "verify": "./verify/bin/verify.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-reporter=spec --test-reporter=./scripts/test-report.js --test-reporter-destination=stdout --test-reporter-destination=test-reporter-out.txt \"dist/test/**/*.test.js\" \"dist/verify/**/*.test.js\" \"dist/lab/**/*.test.js\"",
    "lab:build": "tsc && node dist/lab/tools/build-pages.js",
    "verify": "tsc && node dist/verify/cli.js",
    "verify:scan": "tsc && node dist/verify/scan-cli.js",
    "ppm:print": "tsc && node dist/src/cli.js ppm:print",
    "scan:forbidden": "tsc && node dist/src/cli.js scan:forbidden",
    "drill:killswitch": "tsc && node scripts/killswitch-drill.mjs",
    "logs:verify": "tsc && node dist/src/cli.js logs:verify",
    "logs:status": "tsc && node dist/src/cli.js logs:status",
    "logs:daily": "tsc && node dist/src/cli.js logs:daily",
    "verify:all": "tsc && node scripts/verify-all.mjs",
    "test:browser": "node test/library-notebook.playwright.mjs",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.19.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
